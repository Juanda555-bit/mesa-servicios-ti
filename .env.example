# Copiar a .env y ajustar. No guardar secretos reales en este archivo.

# Opcional: si se omite, se usa el archivo backend/mesa_ti.db
# DATABASE_URL=sqlite:///C:/ruta/absoluta/mesa_ti.db

# Clave para firmar los tokens (obligatoria, mínimo 32 caracteres). Este valor de
# ejemplo es rechazado: la API y el seeder no arrancan hasta que lo reemplace.
# Genere una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambiar-por-una-clave-aleatoria-de-64-caracteres-hex

# Minutos de validez del token (entero mayor que 0; 480 = 8 horas)
JWT_EXPIRA_MIN=480

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173
