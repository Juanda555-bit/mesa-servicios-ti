# Copiar a .env y ajustar. No guardar secretos reales en este archivo.

# Opcional: si se omite, se usa el archivo backend/mesa_ti.db
# DATABASE_URL=sqlite:///C:/ruta/absoluta/mesa_ti.db

# Clave para firmar los tokens. Generar una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Minutos de validez del token (480 = 8 horas)
TOKEN_MINUTOS=480

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173
